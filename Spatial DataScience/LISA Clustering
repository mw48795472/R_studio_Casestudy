## LISA 클러스터링 ##



# LISA :  문화예술기획업 

Entertainment3 <- Entertainment %>%
  filter(!is.na(경도), !is.na(위도))

Entertainment_sf <- st_as_sf(
  Entertainment3,
  coords = c("경도", "위도"),
  crs = 4326)

Entertainment_sf <- st_transform(Entertainment_sf,5179)
st_crs(Entertainment_sf)

grid <- st_make_grid(Entertainment_sf, cellsize=3000, square= TRUE)

grid_sf <-st_sf(id =1:length(grid),geometry=grid)

plot(grid_sf)


grid_sf$count <- lengths(st_intersects(grid_sf,Entertainment_sf))

table(grid_sf$count)

plot(grid_sf["count"])


grid_sf$zscore <- as.numeric(scale(grid_sf$count))

summary(grid_sf$zscore)

XY_Axis_center_sf <- st_coordinates(st_centroid(grid_sf))


knn <- knearneigh(XY_Axis_center_sf,k=3)

nb <-knn2nb(knn)

summary(nb)

lw <- nb2listw(nb,style="W")

grid_sf$lag <- lag.listw(lw,grid_sf$zscore)

summary(grid_sf$lag)

ggplot(grid_sf,aes(x=zscore,y=lag))+geom_point(size=1)+geom_hline(yintercept=-0,lintype=2)+geom_vline(xintercept=0,linetype=2)+theme_bw()

moran.test( grid_sf$count, lw)

local <- localmoran(grid_sf$count,lw)

grid_sf$Ii <- local [,1]
grid_sf$EI <- local [,2]
grid_sf$VI <- local [,3]
grid_sf$ZI <- local [,4]
grid_sf$PI <- local [,5]

head(grid_sf)



grid_sf$LISA <- "Not Significant"

grid_sf$LISA[
  grid_sf$zscore > 0 &
    grid_sf$lag > 0 &
    grid_sf$PI < 0.05
] <- "High-High"

grid_sf$LISA[
  grid_sf$zscore < 0 &
    grid_sf$lag < 0 &
    grid_sf$PI < 0.05
] <- "Low-Low"

grid_sf$LISA[
  grid_sf$zscore > 0 &
    grid_sf$lag < 0 &
    grid_sf$PI < 0.05
] <- "High-Low"

grid_sf$LISA[
  grid_sf$zscore < 0 &
    grid_sf$lag > 0 &
    grid_sf$PI < 0.05
] <- "Low-High"








grid_table <-
  grid_sf %>%
  st_drop_geometry() %>%
  select(
    id,
    count,
    zscore,
    lag,
    Ii,
    ZI,
    PI,
    LISA
  )

head(grid_table)

## LISA를 factor로 변환하여 범례 순서 고정
grid_sf$LISA <- factor(
  grid_sf$LISA,
  levels = c(
    "High-High",
    "Low-Low",
    "High-Low",
    "Low-High",
    "Not Significant"
      ))






## LISA Cluster Map ##


tm_shape(grid_sf) +
  tm_fill(
    col = "LISA",
    palette = c(
      "High-High"       = "navy",      # HH : 남색
      "Low-Low"         = "yellow",    # LL : 노란색
      "High-Low"        = "orange",    # HL : 주황색
      "Low-High"        = "red",       # LH : 빨간색
      "Not Significant" = "gr"    # 유의하지 않음
      ),
    drop.levels = FALSE,               # 데이터에 없어도 범례에 표시
    title = "LISA"
  ) +
  tm_borders(col = "grey30", lwd = 0.5) +
  tm_layout(
    legend.outside = TRUE,
    legend.title.size = 1.2,
    legend.text.size = 0.9,
    frame = TRUE  )


tm_shape(grid_sf) +
  tm_fill(
    col = "LISA",
    palette = c(
      "High-High" = "#08306B",      # HH → 남색
      "Low-Low" = "yellow",      # LL → 노란색
      "High-Low" = "#E31A1C",     # HL → 주황색
      "Low-High" = "#40E0D0",        # LH → 빨간색
      "Not Significant" = "#74C476" # 유의하지 않음
    )
  ) +
  tm_borders()



# Cluster Plot 디자인 

ggplot(grid_sf,
       aes(x = zscore,
           y = lag,
           color = grid_sf$LISA)) +
  
  geom_point(size = 1.0, alpha = 0.7) +
  
  ## 기준선
  geom_vline(xintercept = 0,
             linetype = "dashed",
             colour = "grey40") +
  
  geom_hline(yintercept = 0,
             linetype = "dashed",
             colour = "grey40") +
  
  ## Moran 회귀선
  geom_smooth(method = "lm",
              formula = y ~ x,
              se = FALSE,
              colour = "black",
              linewidth = 1) +
  
  ## 색상
